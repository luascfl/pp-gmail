{
  "manifest_version": "0.3",
  "name": "gmail-pp-mcp",
  "display_name": "Gmail",
  "version": "4.14.0",
  "description": "The Gmail API lets you view and manage Gmail mailbox data like threads, messages, and labels.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/gmail-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/gmail-pp-mcp",
      "args": [],
      "env": {
        "GMAIL_OAUTH2C": "${user_config.gmail_oauth2c}"
      }
    }
  },
  "user_config": {
    "gmail_oauth2c": {
      "type": "string",
      "title": "GMAIL_OAUTH2C",
      "description": "Sets GMAIL_OAUTH2C for the Gmail MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
